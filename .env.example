# --- Application ---
APP_NAME=product-service
APP_ENV=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=product_service

AUTH_SERVICE_BASE_URL=http://authorization:8081

EMBEDDING_RERANKING_BASE_URL=http://embedding-reranking:8003
EMBEDDING_RERANKING_TIMEOUT_SECONDS=30

VECTOR_DB_BASE_URL=http://vector-db:8002
VECTOR_DB_TIMEOUT_SECONDS=10

LLM_PROVIDER_BASE_URL=http://llm-provider:8004
LLM_PROVIDER_TIMEOUT_SECONDS=60

AGENTIC_SEARCH_MAX_ITERATIONS=3
